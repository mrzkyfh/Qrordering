{
  "name": "time420s-assets-worker",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && tsc --noEmit && wrangler deploy --dry-run",
    "check:staging": "npm test && tsc --noEmit && wrangler deploy --dry-run --config wrangler.staging.toml",
    "deploy": "wrangler deploy",
    "optimize:migrated": "node scripts/optimize-migrated-images.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "typescript": "~6.0.2",
    "wrangler": "^4.126.0"
  }
}
