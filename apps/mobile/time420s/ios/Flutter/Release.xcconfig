#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// The vendored GSDK.framework (printer SDK) has no arm64 iOS-simulator slice,
// only x86_64. Exclude arm64 for the simulator so it builds the x86_64 slice
// (runs via Rosetta on Apple Silicon). Device builds are unaffected.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
