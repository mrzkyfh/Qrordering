VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_SUPABASE_FALLBACK_URL=https://your-network-gateway.workers.dev

# Akun khusus QA; jangan gunakan akun owner produksi dan jangan commit nilainya.
E2E_EMAIL=qa@example.com
E2E_PASSWORD=CHANGE_ME
VITE_APP_NAME=Panel Restoran

VITE_MENU_BASE_URL=https://menu.time420s.my.id

# Image write backend. Existing Supabase URLs remain readable in every mode.
# Production value: r2-production. This must be a Worker API URL, never r2.dev
# or the public asset domain.
VITE_IMAGE_STORAGE_BACKEND=
VITE_R2_STAGING_API_URL=
VITE_R2_API_URL=https://time420s-r2-production.official-b0d.workers.dev
