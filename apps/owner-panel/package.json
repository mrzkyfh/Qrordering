{
  "name": "owner-panel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:laporan": "playwright test tests/laporan.spec.ts",
    "test:ui": "playwright test --ui",
    "deploy": "npm run build && wrangler deploy",
    "deploy:prod": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev",
    "check:worker": "npm run build && wrangler deploy --dry-run"
  },
