# Security headers untuk Cloudflare Pages (owner-panel)
# Catatan: jika CSP memblokir aset, uji dulu pakai
# "Content-Security-Policy-Report-Only" di staging sebelum di-enforce.
#
# CSP sengaja menolak dynamic evaluation. Pemeriksaan opsional library yang
# mencoba new Function tertangkap dan otomatis memakai jalur jitless.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://assets.time420s.my.id https://time420s-r2-staging.official-b0d.workers.dev; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.time420s.my.id wss://api.time420s.my.id https://time420s-r2-staging.official-b0d.workers.dev https://time420s-r2-production.official-b0d.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# index.html TIDAK boleh di-cache. Kalau basi, ia menunjuk nama chunk lama yang
# sudah hilang setelah deploy; permintaan chunk itu jatuh ke SPA fallback dan
# dibalas index.html → "'text/html' is not a valid JavaScript MIME type".
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Aset ber-hash: aman di-cache selamanya (nama berubah tiap build).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
